PORT=3000

# Comma-separated list of valid stream keys mapped to their owner (format key:owner).
# Example: d63b2619a3d911e473393cff4bd24a80:ade,another-key:budi
STREAM_KEYS=d63b2619a3d911e473393cff4bd24a80:demo

# Postgres (docker-compose)
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=donation_alert
DB_PORT=5432
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/donation_alert
